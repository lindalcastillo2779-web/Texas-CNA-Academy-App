# ──────────────────────────────────────────────────────────────────────────
# Texas CNA Academy – environment variable template
# Copy this file to .env (or set these in Render / your deployment platform).
# NEVER commit .env with real secrets.
# ──────────────────────────────────────────────────────────────────────────

# ── Buddy LLM provider ─────────────────────────────────────────────────────
# Choose "OPENAI" (default) or "AZURE_OPENAI"
LLM_PROVIDER=OPENAI

# ── OpenAI (default provider) ──────────────────────────────────────────────
OPENAI_API_KEY=sk-...your-key-here...
# Optional: override the default model (gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
# Optional: override the embedding model used by knowledge_loader.py
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Azure OpenAI (set LLM_PROVIDER=AZURE_OPENAI to activate) ───────────────
AZURE_OPENAI_KEY=your-azure-openai-key
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=your-chat-deployment-name
AZURE_OPENAI_API_VERSION=2024-02-01
# Optional: Azure embedding deployment name for knowledge_loader.py
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# ── SMTP (email features) ──────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# ── Admin panel ────────────────────────────────────────────────────────────
ADMIN_SECRET=change-me-to-a-strong-random-string

# ── Stripe billing + entitlements ──────────────────────────────────────────
# Webhook signing secret from Stripe Dashboard > Developers > Webhooks.
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional comma-separated Stripe Price IDs used to map entitlements.
STRIPE_CORE_PRICE_IDS=price_core_monthly,price_core_yearly
STRIPE_PRO_PRICE_IDS=price_pro_monthly,price_pro_yearly
# Optional override for replay protection window in seconds (default 300).
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
# Secret key for server-side Stripe API calls (Checkout session creation, etc.).
STRIPE_SECRET_KEY=sk_live_...or_sk_test_...
# URLs Stripe redirects the user to after checkout (defaults to /dashboard.html).
STRIPE_SUCCESS_URL=https://your-domain.com/dashboard.html?checkout=success
STRIPE_CANCEL_URL=https://your-domain.com/dashboard.html?checkout=cancelled
